BITAGENT_MODE=mock
EXCHANGE_API_BASE_URL=https://devapi.zekabot.com
EXCHANGE_BOT_KEY_ID=
EXCHANGE_BOT_SECRET=
# Alternative combined format: key_id:secret[,key_id2:secret2]
EXCHANGE_BOT_SERVICE_KEYS=
EXCHANGE_TIMEOUT_SECONDS=10
BITAGENT_DEFAULT_MARKET=BTC_USDT
WITHDRAWAL_PENDING_WARNING_THRESHOLD=25
WITHDRAWAL_PENDING_CRITICAL_THRESHOLD=100
MARKET_RANGE_WARNING_PERCENT=5.00
MARKET_RANGE_CRITICAL_PERCENT=10.00
EVIDENCE_DB_PATH=.data/bitagent.db
EVIDENCE_FRESHNESS_WARNING_SECONDS=120
BITAGENT_ACCESS_CONTROL_MODE=observe
# Production identity mode is oidc; pilot_header must not be used for production approval.
BITAGENT_IDENTITY_MODE=pilot_header
BITAGENT_OIDC_ISSUER=
BITAGENT_OIDC_AUDIENCE=
BITAGENT_OIDC_JWKS_URL=
BITAGENT_OIDC_PUBLIC_KEY=
BITAGENT_OIDC_ROLE_CLAIM=bitagent_role
BITAGENT_OIDC_TENANT_CLAIM=tenant_id
BITAGENT_OIDC_REQUIRE_MFA=true
BITAGENT_ACCESS_REVIEW_REF=
BITAGENT_EVENT_WEBHOOK_SECRET=
BITAGENT_EVENT_WEBHOOK_TOLERANCE_SECONDS=300
UPSTREAM_SECURITY_REPORT_PATH=.data/upstream-security-report.json
RELEASE_EVIDENCE_DIRECTORY=integration-input/release-evidence
BITAGENT_CHAT_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.zekabot.com
OLLAMA_MODEL=qwen
OLLAMA_USERNAME=replace-locally
OLLAMA_PASSWORD=replace-locally-after-rotation
OLLAMA_TIMEOUT_SECONDS=60
CHAT_REQUESTS_PER_MINUTE=20
CHAT_CONTEXT_MAX_CHARS=30000
