              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is healthy (not degraded/maintenance)', () => {",
                  "    pm.expect(pm.response.json().data.status).to.eql('healthy');",
                  "});",
                  "pm.test('all components report healthy', () => {",
                  "    const c = pm.response.json().data.components;",
                  "    Object.keys(c).forEach(k => pm.expect(c[k].status, k).to.eql('healthy'));",
                  "});",
                  "pm.test('client clock is within 60s of server (signing requirement)', () => {",
                  "    const skew = Math.abs(Math.floor(Date.now()/1000) - pm.response.json().data.server_time_unix);",
                  "    pm.expect(skew, 'clock skew in seconds').to.be.below(60);",
                  "});"
                ]
              }
            }
