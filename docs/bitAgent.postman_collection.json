          "name": "Expired timestamp (>60s old)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const CryptoJS = require('crypto-js');",
                  "const secret = pm.environment.get('bot_secret');",
                  "const keyId = pm.environment.get('bot_key_id');",
                  "const path = '/api/bot/operations';",
                  "const ts = (Math.floor(Date.now() / 1000) - 300).toString();",
                  "const rid = pm.variables.replaceIn('{{$guid}}').toLowerCase();",
                  "const bodyHash = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855';",
                  "const sig = CryptoJS.HmacSHA256([ 'GET', path, '', ts, rid, bodyHash ].join('\\n'), secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Bot-Key-ID', value: keyId });",
                  "pm.request.headers.upsert({ key: 'X-Request-Timestamp', value: ts });",
                  "pm.request.headers.upsert({ key: 'X-Request-ID', value: rid });",
                  "pm.request.headers.upsert({ key: 'X-Request-Signature', value: sig });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 401 (clock skew)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/bot/operations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bot",
                "operations"
              ]
            }
          }
        },
        {
          "name": "Replayed request ID (run this twice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// First run: expect 200. Second run with the SAME X-Request-ID",
                  "// (Postman Runner 'repeat' with this as the only saved value,",
                  "// or manually copy _last_request_id and hardcode it below):",
                  "// expect 409 request_replayed.",
                  "pm.test('status is 200 or 409 (replay)', () => {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 409) {",
                  "    pm.test('error code is request_replayed', () => pm.expect(pm.response.json().error.code).to.eql('request_replayed'));",
                  "}"
                ]
